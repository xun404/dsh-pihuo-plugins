{
  "name": "dsh-pihuo-plugins",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "PiHuo: DeepSeek Harness plugins that run local ACP processes as chat workers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xun404/dsh-pihuo-plugins.git"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test && node --test scripts/*.test.mjs",
    "cdp": "node scripts/cdp-check.mjs",
    "dev:patch": "node scripts/write-dev-patch.mjs",
    "set-release-version": "node scripts/set-release-version.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": ["@deepseek-ai/*"]
    }
  }
}
