{
  "name": "@pihuo/dsh-pihuo-presets",
  "version": "0.1.0",
  "description": "Installs the PiHuo Leader agent preset into $DSH_HOME/.agent-presets",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib/**/*.js", "lib/**/*.d.ts", "presets/**", "README.md"],
  "scripts": {
    "prepack": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xun404/dsh-pihuo-plugins.git",
    "directory": "packages/presets"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
