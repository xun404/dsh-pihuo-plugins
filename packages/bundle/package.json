{
  "name": "@pihuo/dsh-pihuo",
  "version": "0.1.0",
  "description": "DeepSeek Harness bundle: run local ACP processes as chat workers",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/index.d.ts", "cordis.patch.yml", "README.md"],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "prepack": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pihuo/dsh-pihuo-acp-worker": "workspace:^",
    "@pihuo/dsh-pihuo-acp-ui": "workspace:^",
    "@pihuo/dsh-pihuo-presets": "workspace:^"
  },
  "homepage": "https://github.com/xun404/dsh-pihuo-plugins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xun404/dsh-pihuo-plugins.git",
    "directory": "packages/bundle"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT"
}
